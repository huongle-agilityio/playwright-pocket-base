{
  "name": "pocketbase",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prepare": "cd .. && husky ./PocketBase/.husky",
    "test": "pnpm bddgen && pnpm playwright test",
    "report:playwright": "pnpm exec playwright show-report deploy-report\\playwright\\index.html",
    "report:cucumber": "pnpm exec http-server deploy-report\\cucumber -o",
    "deploy:reports": "pnpm exec vercel --prod --cwd=deploy-report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@types/node": "^24.0.3",
    "@typescript-eslint/eslint-plugin": "^8.34.1",
    "@typescript-eslint/parser": "^8.34.1",
    "dotenv": "^16.5.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.5.0",
    "husky": "^9.1.7",
    "lint-staged": "15.2.2",
    "otpauth": "^9.4.0",
    "playwright-bdd": "^8.3.1",
    "prettier": "^3.5.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "http-server": "^14.1.1",
    "vercel": "^44.2.13"
  }
}
